{
  "expo": {
    "name": "I'm Here",
    "slug": "im-here",
    "version": "1.0.0",
    "scheme": "imhere",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2E8D8",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zoenlabs.imhere",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zoenlabs.imhere",
      "adaptiveIcon": {
        "backgroundColor": "#F2E8D8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4A72C",
          "defaultChannel": "alarme-praticas"
        }
      ],
      "./plugins/withAlarme",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#F2E8D8"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be1499d7-e286-423b-9f3b-e368fbfce55f"
      }
    },
    "owner": "zoen.labs",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/be1499d7-e286-423b-9f3b-e368fbfce55f"
    }
  }
}
